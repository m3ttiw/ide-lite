{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ide-lite",
  "version": "../package.json",
  "identifier": "dev.idelite.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ide-lite",
        "width": 1360,
        "height": 880,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4NTk1MTRDNkMyOThDRkMKUldUOGpDbHNURkZaQ0JBT0dnVDNxQUhXTWtycUk5Y08yTXo0Y3lyeUlJRUpTUlRyNFM5RGV3ZzEK",
      "endpoints": [
        "https://github.com/m3ttiw/ide-lite/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
